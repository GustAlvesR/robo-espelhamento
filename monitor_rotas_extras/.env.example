# Copie para .env (mesma pasta do config.yaml). Valores aqui têm prioridade sobre o config.yaml.
# Nunca envie o .env para o Git: a URL do webhook dá a qualquer um o poder de postar no seu Teams.

# URL gerada pelo Workflows/Power Automate (gatilho "Quando uma solicitação de webhook do Teams for recebida")
ROTAS_TEAMS_WEBHOOK_URL=

# Destinatários do e-mail de fallback, separados por ; ou ,
ROTAS_EMAIL_DESTINATARIOS=

# Opcional: sobrescreve app.url_rotas / app.url_tabela_endereco
# ROTAS_URL_ROTAS=
# ROTAS_URL_TABELA_ENDERECO=
